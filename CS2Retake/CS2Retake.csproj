<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <Version>3.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.370" />
    <!-- CSZoneNet.Plugin.CS2BaseAllocator / CSZoneNet.Plugin.Utils : packages abandonnes, sources internalisees dans Vendor/CSZoneNet (2026-07-03) -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Surclasse la dependance transitive SQLitePCLRaw 2.1.11 (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q, SQLite < 3.50.2) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <Target Name="SyncPluginArtifacts" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\BuildScripts\Sync-PluginArtifacts.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -TargetDir &quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)&quot; -Version &quot;$(Version)&quot; -WorkspaceRoot &quot;$(MSBuildProjectDirectory)\..\..\..&quot;" />
  </Target>
</Project>
